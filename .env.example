# Copie este arquivo pra ".env" (nunca comite o .env — já está no
# .gitignore) e preencha com os valores reais do seu ambiente.

# Connection string do Postgres no Neon. Obrigatória — sem ela o
# servidor nem sobe (ver app_core.py).
DATABASE_URL=postgresql://usuario:senha@host/banco

# Chaves VAPID pra notificação push (Web Push). Opcionais — sem elas o
# servidor sobe normal, só com push notification desativado (ver
# PUSH_HABILITADO em app_core.py). Gere um par novo com
# gerar_chaves_vapid.py.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_EMAIL=mailto:contato@exemplo.com
